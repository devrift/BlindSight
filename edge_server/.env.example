# BlindSight gateway configuration.
#
# README quickstart says `cp .env.example .env`. That file used to be missing,
# so OPENROUTER_API_KEY was never set and /api/chat silently degraded.
#
# Copy this file, fill in what you have, and keep the real one out of git:
#     cp .env.example .env && nano .env
# The server looks in edge_server/.env first, then the repository root.

# --- Tier 2: cloud multimodal companion (OpenRouter) -----------------------
# Without this, /api/chat answers are disabled and the PWA is told so
# explicitly instead of hearing a failure string in the assistant's voice.
OPENROUTER_API_KEY=

# --- Gateway access control -------------------------------------------------
# Optional but strongly recommended: the gateway binds 0.0.0.0 on your LAN and
# /api/chat spends real money. When set, /api/chat and /api/latest-frame
# require `Authorization: Bearer <token>` and the PWA will prompt for it once.
BLINDSIGHT_API_TOKEN=

# --- Tier 1: local vision ----------------------------------------------------
# Override the interpreter + script used for edge inference. Leave unset to use
# `python3 <this directory>/vision_ai.py`.
# NOTE: an absolute path here will win over the script next to the server, so
# prefer the VISION_SCRIPT override below if you need a different file.
VISION_COMMAND=
VISION_SCRIPT=

# Where to look for the exported YOLOv8n ONNX weights. Defaults search
# edge_server/models/yolov8n.onnx and friends; see edge_server/models/README.md.
BLINDSIGHT_MODEL_PATH=

# --- Runtime directories ------------------------------------------------------
# Per-request frames and their audio live here and are swept after TTL seconds.
BLINDSIGHT_DATA=
BLINDSIGHT_RUNTIME_TTL=3600
BLINDSIGHT_DISABLE_SWEEPER=

# A camera frame older than this many seconds is not treated as "live".
BLINDSIGHT_FRAME_MAX_AGE=30

# --- Text to speech ------------------------------------------------------------
ESPEAK_BINARY=espeak-ng

# --- Rate limiting ---------------------------------------------------------------
# Max /api/chat calls per client per minute.
BLINDSIGHT_CHAT_RATE_LIMIT=20

# --- HTTP port (development server only) -------------------------------------------
PORT=5000
