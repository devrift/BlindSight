[Unit]
Description=Svara-TTS (Indic languages, CPU)
After=network.target

[Service]
Type=simple
User=pi
ExecStart=/usr/local/bin/llama-server \
    -m /home/pi/svara-tts/svara-tts-v1.Q4_K_M.gguf \
    --port 8081 --host 0.0.0.0 -t 4 -c 512 --n-gpu-layers 0
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
