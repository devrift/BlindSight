[Unit]
Description=BlindSight Local Vision and Edge Gateway Server
After=network-online.target
Wants=network-online.target

[Service]
User=pi
WorkingDirectory=/home/pi/BlindSight/edge_server
Environment=PYTHONUNBUFFERED=1
# Production WSGI server (gunicorn) with multi-threading for responsive audio and vision requests.
# Fallback if running directly without gunicorn: ExecStart=/usr/bin/python3 /home/pi/BlindSight/edge_server/server.py
ExecStart=/usr/bin/python3 -m gunicorn --workers 1 --threads 4 --bind 0.0.0.0:5000 server:app
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
