# BlindSight Environment Configuration Example
# Copy this file to .env and configure your values:
# cp .env.example .env

# OpenRouter API Key for Cloud Multimodal Companion (Required for /api/chat)
# Get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Optional: Bearer authentication token for securing /api/chat endpoint
# If set, clients must pass 'Authorization: Bearer <token>' or 'X-API-Token: <token>'
BLINDSIGHT_API_TOKEN=

# Optional: Path to custom YOLOv8n ONNX model (defaults to edge_server/models/yolov8n.onnx)
# BLINDSIGHT_MODEL_PATH=edge_server/models/yolov8n.onnx

# Optional: Directory path for runtime files and audio output (defaults to runtime/)
# BLINDSIGHT_DATA=runtime

# Optional: Custom vision command or script path
# VISION_SCRIPT=edge_server/vision_ai.py
# VISION_COMMAND=python3 edge_server/vision_ai.py

# Optional: TTS binary name or absolute path (defaults to espeak-ng)
# ESPEAK_BINARY=espeak-ng
