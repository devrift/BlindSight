# Secrets & Credentials
.env
.env.*
!.env.example
!**/.env.example
*.env
!.env.example
*.key
*.pem
secrets.h
**/include/secrets.h

# Python Cache & Virtual Environments
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.venv/
venv/
env/

# Merge / editor artifacts (these must never be committed again)
*.orig
*.rej
*.bak
*.BACKUP.*
*.BASE.*
*.LOCAL.*
*.REMOTE.*

# Hardware Build Artifacts & IDEs
**/.pio/
**/.vscode/
.idea/

# Heavy Weights & Models
*.pt
*.onnx
edge_server/models/*.onnx

# Runtime Uploads & Generated Audio
runtime/*
!runtime/.gitkeep
uploads/*
!uploads/.gitkeep

# Companion memory / prefs / chat history: personal data, never committed.
state/*
!state/.gitkeep
*.wav
*.pcm
!firmware/esp32_main/data/*.wav

# The LittleFS voice clips ARE source: the firmware's offline fallback is
# silent without them. Generated by firmware/esp32_main/data/generate_clips.sh
# and format-checked by tools/verify_wav.py.
!firmware/esp32_main/data/
!firmware/esp32_main/data/*.wav

# OS Noise
.DS_Store
Thumbs.db
